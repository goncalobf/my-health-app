{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Write(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.*.local)",
      "Write(./.env.*.local)",
      "Read(./.vercel/**)",
      "Edit(./.vercel/**)",
      "Write(./.vercel/**)",
      "Read(./workers/garmin-auth/.dev.vars*)",
      "Edit(./workers/garmin-auth/.dev.vars*)",
      "Write(./workers/garmin-auth/.dev.vars*)"
    ]
  }
}
