# --- Database (Vercel Postgres / Neon) ---
# On Vercel: add the Neon (Postgres) integration and these are injected automatically.
# Locally: run `vercel env pull .env.local` after linking, or paste your connection string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- App unlock ---
# The single password used to unlock the app.
APP_PASSWORD="change-me"
# A long random string used to sign the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Fitlog AI Coach (server-only) ---
# Create a project API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional override. The default is the cost-efficient structured-output model below.
OPENAI_MODEL="gpt-5-mini"

# --- USDA cooked and generic food search (server-only, optional) ---
# Request a free data.gov key for higher limits: https://fdc.nal.usda.gov/api-key-signup/
# Without this, the app uses USDA's rate-limited DEMO_KEY.
FDC_API_KEY=""
NEXT_PUBLIC_APP_TIME_ZONE="Europe/Zurich"
