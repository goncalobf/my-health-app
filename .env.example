# --- Database (Vercel Postgres / Neon) ---
# On Vercel: add the Neon (Postgres) integration and these are injected automatically.
# Locally: run `vercel env pull .env.local` after linking, or paste your connection string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- App unlock ---
# The single password used to unlock the app.
APP_PASSWORD="change-me"
# A long random string used to sign the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
