{
  "name": "my-health-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "icons": "node scripts/generate-icons.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "plan:ppl": "node --env-file=.env.local scripts/apply-ppl-plan.mjs",
    "sync:exercises": "node --env-file=.env.local scripts/sync-exercises.mjs",
    "dev:local": "FITLOG_LOCAL=1 VERCEL= VERCEL_ENV= DATABASE_URL=postgresql://fitlog:fitlog@localhost:55432/fitlog next dev --port 3210",
    "local:db": "DATABASE_URL=postgresql://fitlog:fitlog@localhost:55432/fitlog node scripts/local-db.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.454.0",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
